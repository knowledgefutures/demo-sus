{
  "$schema": "https://console.knowledgefutures.org/schemas/kf.project.v2.json",
  "version": 2,
  "slug": "kf-demo-sus",
  "name": "Single-file Underlay Server (demo)",
  "account": "kf",

  // Deployed by .github/workflows/deploy.yml with values from the console.
