{
  "$schema": "https://console.knowledgefutures.org/schemas/kf.project.v2.json",
  "version": 2,
  "slug": "kf-demo-sus",
  "name": "Single-file Underlay Server (demo)",
  "account": "kf",

  // Deployed by .github/workflows/deploy.yml, not by the console: the console
  // keeps production's key and SSH deploy key, and hands them to that
  // workflow's run on main (kf ci ssh-agent). .env.prod.enc holds only where
  // the deploy goes: DEPLOY_HOST, DEPLOY_USER and DEPLOY_KNOWN_HOSTS.
  "environments": {
    "production": {
      "ref": "heads/main",
      "secrets": [".env.prod.enc"],
      "elsewhere": { "workflow": ".github/workflows/deploy.yml" },
    },
  },
}
